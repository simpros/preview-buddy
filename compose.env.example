# Copy to .env for docker compose: cp compose.env.example .env
#
# Postgres admin credentials (preview-db module uses PB_PREVIEW_POSTGRES_URL)
POSTGRES_USER=pb_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=postgres

# Static preview credentials injected into app/seed containers (v0.1 spec)
PB_PG_USER=pb_preview
PB_PG_PASSWORD=change-me-preview

# Container registry for pulling preview app images (use placeholders for local smoke)
PB_REGISTRY_URL=ghcr.io
PB_REGISTRY_USER=anonymous
PB_REGISTRY_PASSWORD=none

# Operator bootstrap token (leave empty to auto-generate once on first start)
PB_ADMIN_TOKEN=

# Forge API for sweep (GitHub or gitlab)
PB_FORGE=github
PB_FORGE_TOKEN=
