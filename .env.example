# Preview Postgres admin connection (CREATE/DROP DATABASE for preview DBs)
PB_PREVIEW_POSTGRES_URL=postgres://admin:secret@localhost:5432/postgres

# Docker networks
PB_TRAEFIK_NETWORK=traefik
PB_POSTGRES_NETWORK=postgres

# Container registry (pull preview app images)
PB_REGISTRY_URL=registry.example.com
PB_REGISTRY_USER=puller
PB_REGISTRY_PASSWORD=

# Optional tuning (defaults shown)
PB_STATE_DB_PATH=preview-buddy.db
# Operator bootstrap admin token (SHA-256 hash stored in SQLite). If unset on
# first start with no admin token in the DB, the gateway logs a generated token once.
# PB_ADMIN_TOKEN=
PB_TTL_HOURS=72
PB_SWEEP_MINUTES=30
PB_PREVIEW_PORT_DEFAULT=8080
PB_SEED_TIMEOUT=180
PB_PORT=7331
