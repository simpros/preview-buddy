# Shared Postgres admin connection (must be able to CREATE/DROP DATABASE)
PB_DATABASE_URL=postgres://admin:secret@localhost:5432/postgres

# Webhook secrets (forge → preview-buddy)
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# Logical database name prefix (default: prev_pr → prev_pr123)
PB_DB_PREFIX=prev_pr

# Drop preview DBs older than this many hours during sweep
PB_TTL_HOURS=72

# HTTP listen port
PB_PORT=7331
